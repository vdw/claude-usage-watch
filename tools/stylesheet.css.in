/* Generated by tools/gen-css.py from tools/stylesheet.css.in. Do not edit.
 * Dimmed text uses actor opacity in ui/panelIndicator.js, so only the accent
 * colours differ between the variants. */

/* Top bar. The top bar is dark in both styles, so it always uses the dark colours. */
.cuw-panel { spacing: 4px; }
.cuw-tag { font-feature-settings: "tnum"; }
.cuw-tag.cuw-warn { color: @PANEL_WARN@; }
.cuw-tag.cuw-crit { color: @PANEL_CRIT@; font-weight: bold; }
.cuw-tag.cuw-error { color: @PANEL_CRIT@; }

/* Dropdown */
.cuw-account { padding-top: 8px; padding-bottom: 8px; }
.cuw-account-box { spacing: 6px; min-width: 380px; }
.cuw-account-header { spacing: 12px; }
.cuw-account-title { font-weight: bold; }
.cuw-account-subtitle { font-size: 0.85em; }
.cuw-rows { spacing: 4px; }
.cuw-row { spacing: 10px; }
.cuw-row-name { min-width: 7em; font-size: 0.9em; }
.cuw-row-pct { min-width: 3em; text-align: right; font-feature-settings: "tnum"; }
.cuw-row-reset { font-size: 0.85em; }

.cuw-bar-trough {
  width: 140px; /* keep in sync with BAR_WIDTH in ui/panelIndicator.js */
  height: 6px;
  border-radius: 3px;
  background-color: rgba(128, 128, 128, 0.3);
}
.cuw-bar-fill { border-radius: 3px; background-color: @ACCENT@; }
.cuw-bar-fill.cuw-warn { background-color: @WARN@; }
.cuw-bar-fill.cuw-crit { background-color: @CRIT@; }

.cuw-notice { font-size: 0.85em; color: @WARN@; max-width: 380px; }
.cuw-notice.cuw-notice-error { color: @CRIT@; }

.cuw-footer { spacing: 6px; }
.cuw-footer-status { font-size: 0.85em; }
.cuw-footer-button { padding: 6px; border-radius: 99px; }
.cuw-footer-button StIcon { icon-size: 16px; }
